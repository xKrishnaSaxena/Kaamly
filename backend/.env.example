# Copy to .env and fill in. For the free path, create a project at supabase.com,
# then Project Settings -> Database -> Connection string (any format works — the
# backend auto-normalizes it to the async asyncpg driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kaamly

# Comma-separated origins allowed to call the API (the Vite dev server + your PWA host)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_ENV=development

# Optional — enables server speech-to-text (Whisper) + LLM intent extraction.
# Free key at https://console.groq.com . Without it, voice still works via the
# browser's speech recognition + a rule-based parser.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile
